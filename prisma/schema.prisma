// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String       @id @default(ulid())
  name                  String
  reviews               Review[]
  suggestions           Suggestion[]
  lastTimeReviewsViewed DateTime?
}

model Review {
  id      String   @id @default(ulid())
  rating  Int
  comment String?
  tags    String[] @default([])
  posted  DateTime @default(now())
  teaId   String?
  tea     Tea?     @relation(fields: [teaId], references: [id], onDelete: SetNull)
  userId  String?
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Tea {
  id          String   @id @default(ulid())
  name        String   @unique
  tags        String[]
  description String   @default("")
  reviews     Review[]
}

model Suggestion {
  id          String   @id @default(ulid())
  title       String
  description String   @default("")
  postedDate  DateTime
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
